{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dosunit.pe32_program_environment.v1",
  "title": "Explicit initialized PE32 process state",
  "type": "object",
  "required": [
    "schema",
    "environment"
  ],
  "properties": {
    "schema": {
      "const": "dosunit.pe32_program_environment.v1"
    },
    "environment": {
      "type": "object",
      "required": [
        "registers",
        "memory",
        "exit_address"
      ],
      "properties": {
        "registers": {
          "type": "object",
          "required": [
            "eax",
            "ebx",
            "ecx",
            "edx",
            "esi",
            "edi",
            "ebp",
            "esp",
            "eflags"
          ],
          "properties": {
            "eax": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4294967295
                },
                {
                  "type": "string",
                  "pattern": "^(?:0[xX][0-9a-fA-F]+|[0-9]+)$"
                }
              ]
            },
            "ebx": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4294967295
                },
                {
                  "type": "string",
                  "pattern": "^(?:0[xX][0-9a-fA-F]+|[0-9]+)$"
                }
              ]
            },
            "ecx": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4294967295
                },
                {
                  "type": "string",
                  "pattern": "^(?:0[xX][0-9a-fA-F]+|[0-9]+)$"
                }
              ]
            },
            "edx": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4294967295
                },
                {
                  "type": "string",
                  "pattern": "^(?:0[xX][0-9a-fA-F]+|[0-9]+)$"
                }
              ]
            },
            "esi": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4294967295
                },
                {
                  "type": "string",
                  "pattern": "^(?:0[xX][0-9a-fA-F]+|[0-9]+)$"
                }
              ]
            },
            "edi": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4294967295
                },
                {
                  "type": "string",
                  "pattern": "^(?:0[xX][0-9a-fA-F]+|[0-9]+)$"
                }
              ]
            },
            "ebp": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4294967295
                },
                {
                  "type": "string",
                  "pattern": "^(?:0[xX][0-9a-fA-F]+|[0-9]+)$"
                }
              ]
            },
            "esp": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4294967295
                },
                {
                  "type": "string",
                  "pattern": "^(?:0[xX][0-9a-fA-F]+|[0-9]+)$"
                }
              ]
            },
            "eflags": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4294967295
                },
                {
                  "type": "string",
                  "pattern": "^(?:0[xX][0-9a-fA-F]+|[0-9]+)$"
                }
              ]
            }
          },
          "additionalProperties": false
        },
        "memory": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "address",
              "bytes",
              "access"
            ],
            "properties": {
              "address": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4294967295
                  },
                  {
                    "type": "string",
                    "pattern": "^(?:0[xX][0-9a-fA-F]+|[0-9]+)$"
                  }
                ]
              },
              "bytes": {
                "type": "string",
                "pattern": "^(?:[0-9a-fA-F]{2})*$"
              },
              "access": {
                "type": "array",
                "items": {
                  "enum": [
                    "read",
                    "write"
                  ]
                }
              }
            },
            "additionalProperties": false
          },
          "maxItems": 65536
        },
        "exit_address": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            {
              "type": "string",
              "pattern": "^(?:0[xX][0-9a-fA-F]+|[0-9]+)$"
            }
          ]
        },
        "services": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/importService"
          }
        }
      },
      "additionalProperties": false
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "size",
          "oracle_address",
          "candidate_address"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "size": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              },
              {
                "type": "string",
                "pattern": "^(?:0[xX][0-9a-fA-F]+|[0-9]+)$"
              }
            ]
          },
          "oracle_address": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              },
              {
                "type": "string",
                "pattern": "^(?:0[xX][0-9a-fA-F]+|[0-9]+)$"
              }
            ]
          },
          "candidate_address": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              },
              {
                "type": "string",
                "pattern": "^(?:0[xX][0-9a-fA-F]+|[0-9]+)$"
              }
            ]
          }
        },
        "additionalProperties": false
      },
      "maxItems": 65536
    }
  },
  "additionalProperties": false,
  "$defs": {
    "serviceU32": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        {
          "type": "string",
          "pattern": "^(?:0[xX]0*[0-9a-fA-F]{1,8}|(?:0|[1-9][0-9]{0,8}|[1-3][0-9]{9}|4[0-1][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[0-1][0-9]{2}|42949672[0-8][0-9]{1}|429496729[0-4]|4294967295))$(?![\\s\\S])"
        }
      ]
    },
    "importService": {
      "type": "object",
      "required": [
        "dll",
        "name",
        "address",
        "result",
        "volatile",
        "flags"
      ],
      "properties": {
        "dll": {
          "type": "string",
          "minLength": 5,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.$-]+\\.[dD][lL][lL]$(?![\\s\\S])",
          "description": "Parser normalizes DLL identity to lowercase; source declarations accept either case."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.$?@-]+$(?![\\s\\S])",
          "description": "Exact case-sensitive PE export spelling; never lowercase the symbol."
        },
        "address": {
          "$ref": "#/$defs/serviceU32"
        },
        "result": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "kind",
                "value"
              ],
              "properties": {
                "kind": {
                  "const": "declared_dword"
                },
                "value": {
                  "$ref": "#/$defs/serviceU32"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "shared_opaque"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "volatile": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "enum": [
              "ecx",
              "edx"
            ]
          },
          "description": "Parser canonicalizes repeated register names to their first occurrence."
        },
        "flags": {
          "enum": [
            "preserved",
            "opaque"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
