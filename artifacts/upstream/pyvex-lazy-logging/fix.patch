@@ -0,0 +1,34 @@
+"""Regression controls for lazy Gymrat IRSB diagnostics."""
+import logging
+from unittest.mock import patch
+
+import archinfo
+import pyvex
+from pyvex.lifting.util import GymratLifter, Instruction
+
+
+class Nop(Instruction):
+    bin_format = "00000000"
+    name = "logging_nop"
+
+    def compute_result(self):
+        return None
+
+
+class TinyLifter(GymratLifter):
+    instrs = [Nop]
+
+
+def test_disabled_debug_does_not_format_irsb():
+    logger = logging.getLogger("pyvex.lifting.util.lifter_helper")
+    with patch.object(logger, "level", logging.WARNING):
+        with patch.object(pyvex.IRSB, "__str__", side_effect=AssertionError("eager formatting")):
+            block = TinyLifter(archinfo.ArchX86(), 0x1000).lift(b"\x00")
+    assert block.size == 1
+
+
+def test_enabled_debug_formats_irsb(caplog):
+    with caplog.at_level(logging.DEBUG, logger="pyvex.lifting.util.lifter_helper"):
+        block = TinyLifter(archinfo.ArchX86(), 0x1000).lift(b"\x00")
+    assert block.size == 1
+    assert any("IRSB" in record.getMessage() for record in caplog.records)
